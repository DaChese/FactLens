# FactLens Backend — Environment Variables
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.
#
# Alternative: keys can also be set per-browser from the extension's Settings
# page (gear icon in the side panel) instead of editing this file — useful on
# a demo machine you don't want to touch the terminal on. Keys set there are
# sent as request headers and take priority over whatever is here.

# Server
PORT=3001

# Groq — used for BOTH Whisper transcription (Sprint 2+) and LLM fact-checking/bias (Sprint 3+)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# Tavily — used for web search during fact-checking (Sprint 3+)
# Get your free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# NewsAPI — OPTIONAL. Enables multi-outlet coverage analysis and
# missing-context identification. Free developer tier: 100 requests/day.
# Get your free key at: https://newsapi.org
# NEWSAPI_KEY=...

# Self-imposed budget caps — the backend stops calling a provider once the
# cap is hit for the window, so a bug or long demo can't drain the real
# quota. Set slightly below the provider's actual free-tier limits.
# NEWSAPI_DAILY_LIMIT=80
# TAVILY_MONTHLY_LIMIT=900
