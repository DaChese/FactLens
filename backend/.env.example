# FactLens Backend — Environment Variables
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# Server
PORT=3001

# OpenAI — used for Whisper audio transcription
OPENAI_API_KEY=sk-...

# Anthropic — used for Claude fact-checking and bias analysis
ANTHROPIC_API_KEY=sk-ant-...

# Tavily — used for real-time web search during fact-checking
TAVILY_API_KEY=tvly-...
